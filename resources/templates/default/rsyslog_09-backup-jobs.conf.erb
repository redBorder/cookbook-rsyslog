<% unless @ips %>
#Template for RFC5424 formatted logs (failed backup jobs -> incident pipeline)
template(name="backup-jobs-template" type="list") {
    constant(value="{")
      constant(value="\"raw_message\":\"")               property(name="rawmsg" format="json")
      constant(value="\",\"message\":\"")                property(name="msg" format="json")
      constant(value="\",\"pri\":\"")                    property(name="pri" format="json")
      constant(value="\",\"pri_text\":\"")               property(name="pri-text" format="json")
      constant(value="\",\"syslogfacility\":\"")         property(name="syslogfacility" format="json")
      constant(value="\",\"syslogfacility_text\":\"")    property(name="syslogfacility-text" format="json")
      constant(value="\",\"syslogseverity\":\"")         property(name="syslogseverity" format="json")
      constant(value="\",\"syslogseverity_text\":\"")    property(name="syslogseverity-text" format="json")
      constant(value="\",\"protocol_version\":\"")       property(name="protocol-version" format="json")
      constant(value="\",\"timestamp\":\"")              property(name="timegenerated" dateFormat="unixtimestamp")
      constant(value="\",\"hostname\":\"")               property(name="hostname" format="json")
      constant(value="\",\"fromhost_ip\":\"")            property(name="fromhost-ip" format="json")
      constant(value="\",\"app_name\":\"")               property(name="app-name" format="json")
      constant(value="\",\"procid\":\"")                 property(name="procid" format="json")
      constant(value="\",\"msgid\":\"")                  property(name="msgid" format="json")
      constant(value="\",\"incident_uuid\":\"")          property(name="$!rfc5424-sd!backup-event@39483!incident-uuid" format="json")
      constant(value="\",\"incident_uri\":\"")           property(name="$!rfc5424-sd!backup-event@39483!incident-uri" format="json")
      constant(value="\",\"incident_domain\":\"")        property(name="$!rfc5424-sd!backup-event@39483!incident-domain" format="json")
      constant(value="\",\"sensor_name\":\"")            property(name="$!rfc5424-sd!backup-event@39483!sensor-name" format="json")
      constant(value="\",\"sensor_uuid\":\"")            property(name="$!rfc5424-sd!backup-event@39483!sensor-uuid" format="json")
      constant(value="\",\"backup_job_id\":\"")          property(name="$!rfc5424-sd!backup-event@39483!backup-job-id" format="json")
      constant(value="\",\"backup_job_name\":\"")        property(name="$!rfc5424-sd!backup-event@39483!backup-job-name" format="json")
      constant(value="\",\"backup_source\":\"")          property(name="$!rfc5424-sd!backup-event@39483!backup-source" format="json")
      constant(value="\",\"backup_policy\":\"")          property(name="$!rfc5424-sd!backup-event@39483!backup-policy" format="json")
      constant(value="\",\"device_name\":\"")            property(name="$!rfc5424-sd!backup-event@39483!device-name" format="json")
      constant(value="\",\"started_at\":\"")             property(name="$!rfc5424-sd!backup-event@39483!started-at" format="json")
      constant(value="\",\"finished_at\":\"")            property(name="$!rfc5424-sd!backup-event@39483!finished-at" format="json")
      constant(value="\",\"error_message\":\"")          property(name="$!rfc5424-sd!backup-event@39483!error-message" format="json")
      constant(value="\",\"asset_ip_address\":\"")       property(name="$!rfc5424-sd!backup-event@39483!asset-ip-address" format="json")
      constant(value="\",\"asset_mac_address\":\"")      property(name="$!rfc5424-sd!backup-event@39483!asset-mac-address" format="json")
      constant(value="\",\"service_provider\":\"")       property(name="$!rfc5424-sd!backup-event@39483!service_provider" format="json")
      constant(value="\",\"service_provider_uuid\":\"")  property(name="$!rfc5424-sd!backup-event@39483!service_provider-uuid" format="json")
      constant(value="\",\"deployment\":\"")             property(name="$!rfc5424-sd!backup-event@39483!deployment" format="json")
      constant(value="\",\"deployment_uuid\":\"")        property(name="$!rfc5424-sd!backup-event@39483!deployment-uuid" format="json")
      constant(value="\",\"namespace\":\"")              property(name="$!rfc5424-sd!backup-event@39483!namespace" format="json")
      constant(value="\",\"namespace_uuid\":\"")         property(name="$!rfc5424-sd!backup-event@39483!namespace-uuid" format="json")
      constant(value="\",\"organization\":\"")           property(name="$!rfc5424-sd!backup-event@39483!organization" format="json")
      constant(value="\",\"organization_uuid\":\"")      property(name="$!rfc5424-sd!backup-event@39483!organization-uuid" format="json")
      constant(value="\",\"market\":\"")                 property(name="$!rfc5424-sd!backup-event@39483!market" format="json")
      constant(value="\",\"market_uuid\":\"")            property(name="$!rfc5424-sd!backup-event@39483!market-uuid" format="json")
      constant(value="\",\"campus\":\"")                 property(name="$!rfc5424-sd!backup-event@39483!campus" format="json")
      constant(value="\",\"campus_uuid\":\"")            property(name="$!rfc5424-sd!backup-event@39483!campus-uuid" format="json")
      constant(value="\",\"building\":\"")               property(name="$!rfc5424-sd!backup-event@39483!building" format="json")
      constant(value="\",\"building_uuid\":\"")          property(name="$!rfc5424-sd!backup-event@39483!building-uuid" format="json")
      constant(value="\",\"floor\":\"")                  property(name="$!rfc5424-sd!backup-event@39483!floor" format="json")
      constant(value="\",\"floor_uuid\":\"")             property(name="$!rfc5424-sd!backup-event@39483!floor-uuid" format="json")
    constant(value="\"}")
}


if $fromhost-ip == '127.0.0.1' and $app-name == 'backupjobs' and $msgid == 'backup-job-failed' then {
    action(type="omkafka" topic="rb_vault" broker="<%= @kafka_server %>:9092" template="backup-jobs-template")
    stop
}
<% end %>
